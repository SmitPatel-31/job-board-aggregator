# Installed to /etc/jobboard.env and read by both systemd units.
# Owned by root, readable by the jobboard user. No secrets belong here: a
# self-hosted deployment needs no tokens at all (those were only for pushing to
# the GitHub data repo).

# Served root. Holds releases/ and the `current` symlink nginx resolves.
JOBBOARD_DEST=/srv/jobboard

# How many published releases to retain. Each is hardlinked, so extra releases
# cost almost no disk unless the data changed.
JOBBOARD_KEEP=3

# Interpreter. Must be the venv, so the units get the pinned requirements.
PYTHON=/srv/jobboard/app/.venv/bin/python3

# Shared lock serializing the fast and full runs.
JOBBOARD_LOCK=/srv/jobboard/pipeline.lock
